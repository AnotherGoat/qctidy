{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run QCTidy Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/vscode/test",
        "${workspaceFolder}/vscode/test/test_file.py"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "qctidy: compile extension"
    }
  ]
}
