{
  "name": "qctidy-vscode",
  "displayName": "QCTidy Visual Studio Code Extension",
  "description": "AST Analyzer for QCTidy",
  "version": "0.0.1",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qctidy-sidebar",
          "title": "QCTidy",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "qctidy-sidebar": [
        {
          "id": "qctidy-ast-view",
          "name": "AST Analysis"
        }
      ]
    },
    "commands": [
      {
        "command": "qctidy.jumpToLine",
        "title": "Jump to Line"
      },
      {
        "command": "qctidy.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "qctidy.applyFix",
        "title": "Apply Fix",
        "icon": "$(lightbulb)"
      },
      {
        "command": "qctidy.fixAll",
        "title": "Fix All",
        "icon": "$(check-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "qctidy.fixAll",
          "when": "view == qctidy-ast-view",
          "group": "navigation"
        },
        {
          "command": "qctidy.refresh",
          "when": "view == qctidy-ast-view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "qctidy.applyFix",
          "when": "view == qctidy-ast-view && viewItem == qctidyFixable",
          "group": "inline"
        },
        {
          "command": "qctidy.applyFix",
          "when": "view == qctidy-ast-view && viewItem == qctidyFixable",
          "group": "1_fix@1"
        }
      ]
    },
    "configuration": {
      "title": "QCTidy",
      "properties": {
        "qctidy.path": {
          "type": "string",
          "default": "qctidy",
          "description": "Path to the QCTidy executable (default: 'qctidy' from PATH)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
