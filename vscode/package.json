{
  "name": "qctidy-vscode",
  "displayName": "QCTidy Visual Studio Code Extension",
  "description": "AST Analyzer for QCTidy",
  "version": "0.0.1",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qctidy-sidebar",
          "title": "QCTidy",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "qctidy-sidebar": [
        {
          "id": "qctidy-ast-view",
          "name": "AST Analysis"
        }
      ]
    },
    "commands": [
      {
        "command": "qctidy.jumpToLine",
        "title": "Jump to Line"
      },
      {
        "command": "qctidy.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "qctidy.refresh",
          "when": "view == qctidy-ast-view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
